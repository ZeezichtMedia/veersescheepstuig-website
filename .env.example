# Cloudinary Configuration
# Copy this file to .env and fill in your actual credentials

CLOUDINARY_CLOUD_NAME=your-cloud-name-here
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here

# Public URL (accessible in browser)
PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name-here

# --- Sanity opslag-waarschuwing (/api/check-storage) ---
# Geheime sleutel die Vercel Cron meestuurt; verzin een lange willekeurige string.
# Zet dezelfde waarde in de Vercel project-instellingen onder Environment Variables.
CRON_SECRET=verzin-een-lange-willekeurige-string

# Drempel in procenten waarbij de mail verstuurd wordt (standaard 80).
STORAGE_ALERT_THRESHOLD=80

# Ontvanger van de waarschuwing.
ALERT_EMAIL_TO=info@agensea.nl

# SMTP-gegevens van je eigen mailserver (mijn.host / DirectAdmin).
SMTP_HOST=mail.jouw-domein.nl
SMTP_PORT=587
SMTP_USER=noreply@jouw-domein.nl
SMTP_PASS=het-wachtwoord-van-die-mailbox
SMTP_FROM=noreply@jouw-domein.nl
