---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { sanityClient } from "../sanity/client";
import coriaSongs from "../data/coriaSongs.json";

interface CoriaSong {
    num: number | null;
    title: string;
    file: string;
}

const songs = coriaSongs as CoriaSong[];

interface SanityAnnouncement {
    _id: string;
    title: string;
    date: string;
    location?: string;
    openbaar?: boolean;
    tenue?: string;
    zwartBoekje?: boolean;
    programma?: string;
    opmerking?: string;
}

const announcements: SanityAnnouncement[] = await sanityClient.fetch(`
  *[_type == "announcement"] | order(date asc) {
    _id, title, date, location, openbaar, tenue, zwartBoekje, programma, opmerking
  }
`);

const heroImage = "/images/Ledenportaal_header.jpg";
const heroTitle = "Ledenportaal";
const heroSubtitle = "Informatie, kleding en oefenmateriaal voor leden";

const tenues = [
    {
        naam: "Zomertenue",
        icon: "☀️",
        items: [
            "Gestreepte polo",
            "Effen blauwe kiel",
            "Beige broek",
            "Donkerblauwe sokken",
            "Zwarte schoenen",
        ],
    },
    {
        naam: "Wintertenue",
        icon: "❄️",
        items: [
            "T-shirt (wit) met ronde hals",
            "Gestreepte kiel",
            "Donkerblauwe broek",
            "Donkerblauwe sokken",
            "Zwarte schoenen",
        ],
    },
    {
        naam: "Concerttenue",
        icon: "🎵",
        items: [
            "Wit onderhemd (zonder mouw)",
            "Wit overhemd met dasje (onder de kraag en knoopjes dicht)",
            "Gestreept hesje",
            "Donkerblauwe broek met bretels",
            "Donkerblauwe sokken",
            "Zwarte schoenen",
            "Zwarte riem",
        ],
    },
    {
        naam: "Tropentenue",
        icon: "🌴",
        items: [
            "Wit onderhemd (zonder mouw)",
            "Wit shirt met korte mouw en veter",
            "Blauwe broek",
            "Donkerblauwe sokken",
            "Zwarte schoenen",
        ],
    },
    {
        naam: "Begrafenis",
        icon: "🕊️",
        items: ["Wintertenue", "Rouwband (wordt uitgedeeld)", "Jack van HVS"],
    },
];
---

<BaseLayout
    title="Ledenportaal - Het Veerse Scheepstuig"
    description="Ledenportaal met kleding, oefenbestanden en bladmuziek voor de leden van Het Veerse Scheepstuig."
>
    <!-- Prevent indexing of member portal -->
    <meta name="robots" content="noindex, nofollow" slot="head" />

    <!-- Hero Section -->
    <section
        class="relative h-[60vh] flex items-center justify-center overflow-hidden"
    >
        <img
            src={heroImage}
            alt="Hero afbeelding Ledenportaal"
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
        />
        <div
            class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"
        >
        </div>

        <div class="relative z-10 text-center px-4 max-w-5xl mx-auto">
            <h1
                class="text-5xl md:text-7xl font-bold text-white mb-6 drop-shadow-2xl"
            >
                {heroTitle}
            </h1>
            <p class="text-xl md:text-2xl text-white/95 drop-shadow-lg">
                {heroSubtitle}
            </p>
        </div>
    </section>

    <!-- Informatie Section -->
    {announcements.length > 0 && (
    <Section id="informatie" padding="large">
        <div class="max-w-4xl mx-auto">
            <SectionHeader title="Informatie" align="center" />

            <div class="space-y-6 mt-8">
                {announcements.map((item) => {
                    const d = new Date(item.date);
                    const dag = d.toLocaleDateString('nl-NL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

                    return (
                        <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8 border border-gray-100">
                            <h3 class="text-2xl font-bold text-primary mb-4">{item.title}</h3>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-gray-700 mb-4">
                                <div class="flex items-center gap-2">
                                    <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    <span>{dag}</span>
                                </div>
                                {item.location && (
                                    <div class="flex items-center gap-2">
                                        <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        </svg>
                                        <span>{item.location}</span>
                                    </div>
                                )}
                                <div class="flex items-center gap-2">
                                    {item.openbaar ? (
                                        <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    ) : (
                                        <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                        </svg>
                                    )}
                                    <span>{item.openbaar ? 'Openbaar' : 'Niet openbaar'}</span>
                                </div>
                                {item.tenue && (
                                    <div class="flex items-center gap-2">
                                        <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                        <span class="capitalize">{item.tenue}</span>
                                    </div>
                                )}
                                <div class="flex items-center gap-2">
                                    <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                    </svg>
                                    <span>Zwarte boekje: {item.zwartBoekje ? 'Ja' : 'Nee'}</span>
                                </div>
                            </div>

                            {item.programma && (
                                <div class="mt-4 pt-4 border-t border-gray-100">
                                    <h4 class="font-semibold text-gray-900 mb-2">Programma</h4>
                                    <div class="text-gray-700 whitespace-pre-line">{item.programma}</div>
                                </div>
                            )}

                            {item.opmerking && (
                                <div class="mt-4 pt-4 border-t border-gray-100 bg-amber-50 -mx-6 -mb-6 md:-mx-8 md:-mb-8 px-6 py-4 md:px-8 md:py-5 rounded-b-2xl">
                                    <p class="text-amber-800 font-medium flex items-start gap-2">
                                        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                        </svg>
                                        {item.opmerking}
                                    </p>
                                </div>
                            )}
                        </div>
                    );
                })}
            </div>
        </div>
    </Section>
    )}

    <!-- Tenues Foto Section -->
    <Section id="tenues-foto" padding="large">
        <div class="max-w-4xl mx-auto">
            <SectionHeader title="Onze Tenues" align="center" />
            <p class="text-center text-gray-600 mb-8 text-lg">
                Van links naar rechts: Tropentenue, Zomertenue, Wintertenue en
                Concerttenue
            </p>
            <div class="relative rounded-2xl overflow-hidden shadow-2xl">
                <img
                    src="/images/tenues_overzicht.jpg"
                    alt="Overzicht van de vier tenues: tropentenue, zomertenue, wintertenue en concerttenue"
                    class="w-full object-cover"
                    loading="lazy"
                />
                <!-- Labels onder de foto -->
                <div
                    class="absolute bottom-0 left-0 right-0 grid grid-cols-4 bg-gradient-to-t from-black/80 to-transparent"
                >
                    <div class="text-center text-white py-3 px-1">
                        <span class="text-2xl block">🌴</span>
                        <span class="text-sm font-semibold">Tropentenue</span>
                    </div>
                    <div class="text-center text-white py-3 px-1">
                        <span class="text-2xl block">☀️</span>
                        <span class="text-sm font-semibold">Zomertenue</span>
                    </div>
                    <div class="text-center text-white py-3 px-1">
                        <span class="text-2xl block">❄️</span>
                        <span class="text-sm font-semibold">Wintertenue</span>
                    </div>
                    <div class="text-center text-white py-3 px-1">
                        <span class="text-2xl block">🎵</span>
                        <span class="text-sm font-semibold">Concerttenue</span>
                    </div>
                </div>
            </div>
        </div>
    </Section>

    <!-- Kledinglijst Section -->
    <Section id="kledinglijst" padding="large">
        <div class="max-w-6xl mx-auto">
            <SectionHeader title="Kledinglijst per tenue" align="center" />

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8"
            >
                {
                    tenues.map((tenue) => (
                        <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8 hover:shadow-2xl transition-shadow duration-300 border border-gray-100">
                            <div class="flex items-center gap-3 mb-5">
                                <span class="text-3xl">{tenue.icon}</span>
                                <h3 class="text-xl font-bold text-primary">
                                    {tenue.naam}
                                </h3>
                            </div>
                            <ul class="space-y-2">
                                {tenue.items.map((item) => (
                                    <li class="flex items-start gap-2 text-gray-700">
                                        <span class="text-primary mt-1 text-sm">
                                            ▸
                                        </span>
                                        <span>{item}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </Section>

    <!-- Uitleg Microfoon Section -->
    <Section id="uitleg-microfoon" padding="large">
        <div class="max-w-4xl mx-auto">
            <SectionHeader title="Uitleg Microfoon Gebruik" align="center" />
            <p class="text-center text-gray-600 mb-8 text-lg">
                Bekijk in deze video hoe je op de juiste manier gebruik maakt
                van de microfoons tijdens optredens.
            </p>
            <div
                class="relative w-full overflow-hidden rounded-2xl shadow-xl bg-gray-900"
                style="padding-top: 56.25%;"
            >
                <iframe
                    class="absolute top-0 left-0 w-full h-full border-0"
                    src="https://www.youtube.com/embed/sN84I0baowg?rel=0"
                    title="Uitleg microfoon gebruik Veerse Scheepstuig"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                >
                </iframe>
            </div>
        </div>
    </Section>

    <!-- Oefenbestanden (Coria) -->
    <Section id="muziekfiles" padding="large">
        <div class="max-w-5xl mx-auto">
            <SectionHeader
                title="Oefenbestanden"
                subtitle="Oefen je eigen partij online met Coria"
                align="center"
            />

            <!-- Uitleg -->
            <div
                class="bg-primary-50 border border-primary-100 rounded-2xl p-6 md:p-8 mt-8"
            >
                <div class="flex items-start gap-4">
                    <div
                        class="w-12 h-12 bg-primary rounded-full flex items-center justify-center flex-shrink-0"
                    >
                        <svg
                            class="w-6 h-6 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
                            ></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2">
                            Zo werkt het
                        </h3>
                        <p class="text-gray-700 leading-relaxed">
                            Klik op een lied hieronder. Je opent dan Coria, waar je
                            jouw stemgroep kiest en op start drukt om je partij te
                            horen. Via <span class="font-medium">instellingen</span> pas
                            je het tempo aan en het volume van je eigen partij en de
                            andere stemmen. Oefenen kan overal met internet, je hoeft
                            niets te installeren.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Zoekbalk -->
            <div class="mt-8 mb-6">
                <div class="relative max-w-md mx-auto">
                    <svg
                        class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        ></path>
                    </svg>
                    <input
                        id="coria-search"
                        type="search"
                        placeholder="Zoek op titel of nummer..."
                        autocomplete="off"
                        class="w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-primary outline-none transition-colors"
                    />
                </div>
                <p
                    class="text-center text-sm text-gray-500 mt-3"
                    id="coria-count"
                >
                    {songs.length} oefenbestanden
                </p>
            </div>

            <!-- Lijst -->
            <div id="coria-list" class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {
                    songs.map((song) => (
                        <a
                            href={`/coria/${song.file}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="coria-item group flex items-center gap-4 bg-white rounded-xl border border-gray-200 p-3 pr-4 hover:border-primary hover:shadow-md transition-all"
                            data-title={song.title.toLowerCase()}
                            data-num={song.num ?? ""}
                        >
                            <span class="flex-shrink-0 w-11 h-11 rounded-lg bg-primary-50 text-primary font-bold flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
                                {song.num ?? "♪"}
                            </span>
                            <span class="flex-1 min-w-0 font-medium text-gray-800 group-hover:text-primary transition-colors truncate">
                                {song.title}
                            </span>
                            <svg
                                class="flex-shrink-0 w-6 h-6 text-gray-300 group-hover:text-primary transition-colors"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                                />
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                />
                            </svg>
                        </a>
                    ))
                }
            </div>

            <!-- Geen resultaten -->
            <p
                id="coria-empty"
                class="text-center text-gray-500 py-10 hidden"
            >
                Geen liedjes gevonden. Probeer een andere zoekterm.
            </p>
        </div>
    </Section>

    <script>
        const search = document.getElementById(
            "coria-search",
        ) as HTMLInputElement | null;
        const items = Array.from(
            document.querySelectorAll<HTMLElement>(".coria-item"),
        );
        const count = document.getElementById("coria-count");
        const empty = document.getElementById("coria-empty");
        const total = items.length;

        function applyFilter() {
            const q = (search?.value || "").trim().toLowerCase();
            let visible = 0;
            for (const item of items) {
                const title = item.getAttribute("data-title") || "";
                const num = item.getAttribute("data-num") || "";
                const match = !q || title.includes(q) || num.includes(q);
                item.style.display = match ? "" : "none";
                if (match) visible++;
            }
            if (count) {
                count.textContent = q
                    ? `${visible} van ${total} oefenbestanden`
                    : `${total} oefenbestanden`;
            }
            if (empty) empty.style.display = visible === 0 ? "block" : "none";
        }

        search?.addEventListener("input", applyFilter);
    </script>
</BaseLayout>
